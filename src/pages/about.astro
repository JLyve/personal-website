---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import ProvisionalEmptyState from '../components/ProvisionalEmptyState.astro';
---

<BaseLayout
  editorial
  title="About — Structure preview"
  description="A provisional About page awaiting approved personal and professional context."
>
  <Navigation />
  <ProvisionalEmptyState
    eyebrow="About · Structure preview"
    title="An introduction belongs here—after approval."
    description="This page is reserved for an approved introduction and truthful context. The design is ready; the personal wording will be developed separately."
    statusTitle="No owner biography is published."
    statusDescription="The original Darkness demo biography and service claims have been removed. No personal history, credentials, or professional claims are assumed."
    structureLabel="Provisional page structure"
    structureItems={['Approved introduction', 'Working perspective', 'Relevant evidence and paths']}
  />
</BaseLayout>
