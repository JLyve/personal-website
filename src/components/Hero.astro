---
interface Props {
  portraitSrc?: string;
}

const { portraitSrc } = Astro.props;
---

<section class="welcome" aria-labelledby="welcome-title">
  <div class="alchemy-atmosphere" aria-hidden="true">
    <svg viewBox="0 0 260 260" fill="none">
      <g class="slow-orbit">
        <circle cx="130" cy="130" r="76" />
        <ellipse cx="130" cy="130" rx="112" ry="45" transform="rotate(-28 130 130)" />
        <path d="M130 44 205 174H55L130 44Z" />
        <path d="m130 82 48 48-48 48-48-48 48-48Z" />
      </g>
      <path class="fine-line" d="M18 130h224M130 18v224" />
      <circle class="center-point" cx="130" cy="130" r="3" />
      <circle class="wandering-point" cx="218" cy="78" r="2" />
    </svg>
    <span class="field-glyph glyph-one">✦</span>
    <span class="field-glyph glyph-two">◇</span>
  </div>

  {portraitSrc && (
    <div class="portrait-placement">
      <img
        class="portrait-image"
        src={portraitSrc}
        alt="Jason Lyvers"
        width="320"
        height="320"
        decoding="async"
      />
    </div>
  )}

  <div class="welcome-copy">
    <p class="preview-label">A brief welcome <span aria-hidden="true">·</span> provisional wording</p>
    <h1 id="welcome-title">
      I’m Jason Lyvers, a <span class="profession-accent"><span class="profession-start">digital<svg class="profession-star" aria-hidden="true" focusable="false" viewBox="0 0 16 16"><path d="M8 0 10 6 16 8 10 10 8 16 6 10 0 8 6 6Z" /></svg></span> <span class="profession-middle">marketing<span class="profession-spark spark-start" aria-hidden="true"></span></span> <span class="profession-ending">strategist<span class="profession-spark spark-end" aria-hidden="true"></span></span></span>. That explains some of what you’ll find here.
    </h1>
    <p>
      The rest involves books, ideas, questions, and connections I’m still trying to explain. Have a look around.
    </p>
  </div>
</section>

<style>
  .welcome {
    min-width: 0;
    padding: 0.6rem 0 2.4rem;
    position: relative;
    isolation: isolate;
  }

  .welcome::after {
    content: '✦';
    position: absolute;
    left: 0;
    bottom: 0;
    color: rgba(207, 167, 104, 0.65);
    font-size: 0.62rem;
    text-shadow: 0 0 18px rgba(196, 155, 99, 0.45);
  }

  .welcome-copy {
    max-width: 630px;
    position: relative;
    z-index: 1;
  }

  .portrait-placement {
    margin-bottom: 1.35rem;
    position: relative;
    z-index: 1;
  }

  .portrait-image {
    width: 88px;
    height: 88px;
    display: block;
  }

  .preview-label {
    margin: 0 0 1.15rem;
    color: #bd9966;
    font-size: 0.66rem;
    font-weight: 650;
    letter-spacing: 0.17em;
    line-height: 1.5;
    text-transform: uppercase;
  }

  h1 {
    max-width: 23ch;
    margin: 0;
    color: var(--color-text);
    font-family: 'Newsreader', Georgia, serif;
    font-size: clamp(1.75rem, 2.7vw, 2.35rem);
    font-weight: 350;
    letter-spacing: -0.024em;
    line-height: 1.13;
    text-wrap: balance;
  }

  .profession-accent {
    color: #d3b17c;
    font-family: 'Fraunces', Georgia, serif;
    font-style: italic;
    font-weight: 400;
    background: radial-gradient(ellipse, rgba(195, 154, 97, 0.045), transparent 72%);
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
  }

  .profession-start,
  .profession-middle,
  .profession-ending {
    position: relative;
  }

  .profession-ending {
    white-space: nowrap;
  }

  .profession-star,
  .profession-spark {
    offset-position: auto;
    offset-anchor: left top;
    offset-rotate: 0deg;
    offset-distance: 0%;
  }

  .profession-star {
    width: 0.24em;
    height: 0.24em;
    position: absolute;
    left: 0.45em;
    top: -0.14em;
    z-index: -1;
    display: block;
    overflow: visible;
    fill: #d6b477;
    filter: drop-shadow(0 0 3px rgba(214, 180, 119, 0.4));
    pointer-events: none;
    opacity: 0.85;
    offset-path: path('M0 0 C4 -3 8 -3 8 0 C8 3 4 3 0 0 C-4 -3 -8 -3 -8 0 C-8 3 -4 3 0 0 Z');
    animation: profession-wander 16s linear infinite,
      profession-shimmer 17s ease-in-out infinite;
    animation-delay: -3s, -5s;
    transition: none;
  }

  .profession-spark {
    width: clamp(6px, 0.18em, 7px);
    height: clamp(6px, 0.18em, 7px);
    position: absolute;
    z-index: -1;
    background: #d6b477;
    clip-path: polygon(50% 0, 63% 37%, 100% 50%, 63% 63%, 50% 100%, 37% 63%, 0 50%, 37% 37%);
    opacity: 0.62;
    pointer-events: none;
    user-select: none;
    animation: profession-wander 19s linear infinite,
      profession-shimmer 16s ease-in-out infinite;
    animation-delay: -7s, -3s;
  }

  .spark-start {
    top: -0.11em;
    left: 0.5em;
    offset-path: path('M0 0 C-1 -2 2 -4 5 -3 C8 -2 10 1 7 2 C4 3 1 2 0 0 Z');
  }

  .spark-end {
    bottom: 0.01em;
    left: 55%;
    offset-path: path('M0 0 C0 2 -3 3 -6 2 C-9 1 -10 -2 -7 -3 C-4 -4 0 -2 0 0 Z');
    animation-duration: 13s, 19s;
    animation-delay: -10s, -7s;
  }

  @keyframes profession-wander {
    from { offset-distance: 0%; }
    to { offset-distance: 100%; }
  }

  @keyframes profession-shimmer {
    0%, 30%, 74%, 100% { opacity: 0.62; }
    52% { opacity: 0.95; }
  }

  .welcome-copy > p:last-child {
    max-width: 52ch;
    margin: 1.15rem 0 0;
    color: var(--color-text-dim);
    font-size: clamp(0.93rem, 1.15vw, 1rem);
    line-height: 1.72;
  }

  .alchemy-atmosphere {
    width: min(104px, calc(var(--opening-gap, 5rem) - 16px));
    aspect-ratio: 1;
    position: absolute;
    right: calc(var(--opening-gap, 5rem) / -2);
    top: 54%;
    z-index: -1;
    color: #c39a61;
    opacity: 0.28;
    pointer-events: none;
    transform: translate(50%, -50%);
  }

  .alchemy-atmosphere svg {
    width: 100%;
    height: 100%;
    overflow: visible;
    stroke: currentColor;
    stroke-width: 0.65;
  }

  .slow-orbit {
    transform-origin: 130px 130px;
    animation: alchemy-turn 36s linear infinite;
  }

  .fine-line {
    opacity: 0.24;
    stroke-dasharray: 1 9;
  }

  .center-point,
  .wandering-point {
    fill: #d9b578;
    stroke: none;
    filter: drop-shadow(0 0 8px rgba(217, 181, 120, 0.8));
  }

  .field-glyph {
    position: absolute;
    color: #d9b578;
    line-height: 1;
  }

  .glyph-one { top: 8%; right: 14%; font-size: 0.68rem; }
  .glyph-two { left: 4%; bottom: 17%; font-size: 0.8rem; opacity: 0.68; }

  @keyframes alchemy-turn {
    to { transform: rotate(360deg); }
  }

  @media (max-width: 860px) {
    .alchemy-atmosphere { display: none; }
  }

  @media (max-width: 720px) {
    .welcome {
      padding-top: 0;
      padding-bottom: 2.25rem;
    }

    h1 {
      max-width: 24ch;
      font-size: clamp(1.72rem, 7.6vw, 2.05rem);
      line-height: 1.13;
    }

    .portrait-placement { margin-bottom: 1.1rem; }
    .portrait-image { width: 68px; height: 68px; }
  }

  @media (max-width: 370px) {
    h1 { font-size: 1.68rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .slow-orbit { animation: none; }

    .profession-star,
    .profession-spark {
      animation: none;
      transform: none;
      offset-path: none;
      offset-distance: 0%;
    }

    .profession-star { opacity: 0.85; }

    .profession-spark {
      opacity: 0.62;
    }
  }
</style>
