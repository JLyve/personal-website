---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import Hero from '../components/Hero.astro';
import EditorialCard from '../components/EditorialCard.astro';

const base = import.meta.env.BASE_URL;

const previewCards = [
  {
    kind: 'Preview placement · Note',
    title: 'An approved Note will live here',
    description: 'A future handpicked Note can use this space after its title, summary, and publication details are approved.',
    href: `${base}blog/`,
    action: 'Preview the Notes structure',
  },
  {
    kind: 'Preview placement · Project',
    title: 'A real project will take this place',
    description: 'This layout reserves room for truthful project context without inventing outcomes, clients, or accomplishments.',
    href: `${base}projects/`,
    action: 'Preview the Projects structure',
  },
];
---

<BaseLayout
  editorial
  title="The Curiosity Engine — Homepage design preview"
  description="A review-only homepage design preview with provisional wording and no unpublished personal content."
>
  <Navigation />

  <main class="curiosity-home">
    <Hero />

    <section class="selected section-shell" id="selected" aria-labelledby="selected-title">
      <div class="section-heading">
        <div>
          <p class="section-kicker">Curated, eventually</p>
          <h2 id="selected-title">Selected Curiosities</h2>
        </div>
        <p class="section-intro">
          <strong>Preview only:</strong> these two featured placements test the editorial rhythm. No owner-authored Notes, projects, or private ideas are included.
        </p>
      </div>

      <div class="card-grid">
        {previewCards.map((card) => <EditorialCard {...card} />)}
      </div>
    </section>

    <section class="paths section-shell" id="paths" aria-labelledby="paths-title">
      <div class="paths-copy">
        <p class="section-kicker">Provisional wayfinding</p>
        <h2 id="paths-title">Paths through the collection</h2>
        <p>
          These interests are structural examples, not claims about a finished archive. They show how readers might enter through a subject rather than a publishing date.
        </p>
      </div>

      <div class="path-list" aria-label="Collection paths">
        <a href={`${base}blog/`}>
          <span class="path-number" aria-hidden="true">01</span>
          <span>Ideas &amp; Notes</span>
          <svg class="path-arrow" aria-hidden="true" width="16" height="16" viewBox="0 0 16 16" fill="none">
            <path d="M4 4h8v8M12 4 4.5 11.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
        <a href={`${base}projects/`}>
          <span class="path-number" aria-hidden="true">02</span>
          <span>Projects &amp; Experiments</span>
          <svg class="path-arrow" aria-hidden="true" width="16" height="16" viewBox="0 0 16 16" fill="none">
            <path d="M4 4h8v8M12 4 4.5 11.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
        <div class="path-placeholder" id="reading" aria-label="Reading path is reserved for future approved entries">
          <span class="path-number" aria-hidden="true">03</span>
          <span>Reading &amp; Books</span>
          <span class="path-status">approved entries pending</span>
        </div>
      </div>
    </section>

    <section class="context section-shell" aria-labelledby="context-title">
      <div class="context-mark" aria-hidden="true">
        <span></span>
      </div>
      <div class="context-copy">
        <p class="section-kicker">About section preview</p>
        <h2 id="context-title">A little context, when the words are ready.</h2>
        <p>
          This area is reserved for an approved introduction and a grounded bridge to meaningful work. The preview deliberately makes no biographical or professional claims.
        </p>
        <div class="context-links">
          <a href={`${base}about/`}>Preview the About structure <span aria-hidden="true">→</span></a>
          <a href={`${base}projects/`}>Preview the Projects structure <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div>
      <p class="footer-mark" aria-hidden="true">✦</p>
      <p>Homepage design preview. All displayed copy remains provisional.</p>
    </div>
    <p>
      Built from the open-source <a href="https://github.com/kpab/astro-darkness">Darkness Astro theme</a> by kpab.
    </p>
  </footer>
</BaseLayout>

<style>
  .curiosity-home {
    color: var(--color-text);
  }

  .section-shell,
  .site-footer {
    width: min(100% - 2rem, 1180px);
    margin-inline: auto;
  }

  .section-kicker {
    margin: 0 0 0.8rem;
    color: #bd9966;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.17em;
    text-transform: uppercase;
  }

  h2 {
    margin: 0;
    color: var(--color-text);
    font-family: 'Newsreader', Georgia, serif;
    font-size: clamp(2.7rem, 6.8vw, 5.25rem);
    font-weight: 300;
    letter-spacing: -0.04em;
    line-height: 0.98;
    text-wrap: balance;
  }

  .selected {
    padding: clamp(4rem, 7vw, 6rem) 0;
    border-top: 1px solid rgba(205, 170, 112, 0.15);
    scroll-margin-top: 6rem;
  }

  .section-heading {
    margin-bottom: clamp(2.25rem, 4vw, 3.5rem);
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(280px, 0.8fr);
    align-items: end;
    gap: 2rem;
  }

  .section-intro {
    max-width: 45ch;
    margin: 0 0 0.25rem auto;
    color: var(--color-text-dim);
    font-size: 0.94rem;
    line-height: 1.72;
  }

  .section-intro strong {
    color: #d5bb93;
    font-weight: 600;
  }

  .card-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .paths {
    padding: clamp(4.75rem, 8vw, 7rem) 0;
    display: grid;
    grid-template-columns: minmax(260px, 0.75fr) minmax(360px, 1.25fr);
    gap: clamp(3rem, 10vw, 8rem);
  }

  #reading {
    scroll-margin-top: 7rem;
  }

  .paths-copy h2 {
    max-width: 9ch;
  }

  .paths-copy > p:last-child {
    max-width: 43ch;
    margin: 1.5rem 0 0;
    color: var(--color-text-dim);
    font-size: 0.97rem;
    line-height: 1.75;
  }

  .path-list {
    border-top: 1px solid rgba(205, 170, 112, 0.2);
  }

  .path-list a,
  .path-placeholder {
    min-height: 86px;
    padding: 1rem 0.25rem;
    display: grid;
    grid-template-columns: 42px 1fr auto;
    align-items: center;
    gap: 0.8rem;
    border-bottom: 1px solid rgba(205, 170, 112, 0.2);
    color: var(--color-text);
    font-family: 'Newsreader', Georgia, serif;
    font-size: clamp(1.35rem, 3vw, 1.8rem);
    text-decoration: none;
  }

  .path-list a {
    transition: color 180ms ease, padding 180ms ease, background 180ms ease;
  }

  .path-list a:hover,
  .path-list a:focus-visible {
    padding-inline: 0.75rem;
    background: rgba(205, 170, 112, 0.04);
    color: #e0c697;
  }

  .path-number,
  .path-status {
    color: #9e8768;
    font-family: 'Manrope', system-ui, sans-serif;
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .path-arrow {
    color: #b7925f;
    font-family: 'Manrope', system-ui, sans-serif;
    font-size: 0.9rem;
  }

  .path-placeholder {
    color: #b9ae9f;
  }

  .context {
    padding: clamp(4rem, 7vw, 6.5rem) clamp(1.3rem, 5vw, 4.5rem);
    display: grid;
    grid-template-columns: minmax(110px, 150px) minmax(0, 1fr);
    align-items: center;
    gap: clamp(2.5rem, 8vw, 7rem);
    border: 1px solid rgba(205, 170, 112, 0.15);
    background: rgba(35, 27, 21, 0.52);
  }

  .context-mark {
    width: min(100%, 140px);
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    position: relative;
    border: 1px solid rgba(205, 170, 112, 0.08);
    border-radius: 50%;
  }

  .context-mark::before,
  .context-mark::after,
  .context-mark span {
    content: '';
    position: absolute;
    border: 1px solid rgba(205, 170, 112, 0.07);
  }

  .context-mark::before {
    inset: 20%;
    transform: rotate(45deg);
  }

  .context-mark::after {
    width: 44%;
    height: 44%;
    border-radius: 50%;
  }

  .context-mark span {
    width: 5px;
    height: 5px;
    border-color: rgba(221, 185, 126, 0.38);
    border-radius: 50%;
    box-shadow: 0 0 18px rgba(221, 185, 126, 0.24);
  }

  .context-copy h2 {
    max-width: 12ch;
    font-size: clamp(2.6rem, 6vw, 4.8rem);
  }

  .context-copy > p {
    max-width: 56ch;
    margin: 1.4rem 0 0;
    color: var(--color-text-dim);
    font-size: 0.97rem;
    line-height: 1.75;
  }

  .context-links {
    margin-top: 1.8rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem 1.5rem;
  }

  .context-links a {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    color: #d7b77f;
    font-size: 0.84rem;
    font-weight: 600;
    text-decoration-color: rgba(215, 183, 127, 0.45);
    text-underline-offset: 0.28rem;
  }

  .context-links a:hover,
  .context-links a:focus-visible {
    color: #f0d9ae;
  }

  .site-footer {
    margin-top: clamp(4.5rem, 8vw, 6.5rem);
    padding: 2rem 0 2.5rem;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
    border-top: 1px solid rgba(205, 170, 112, 0.15);
    color: #9f9588;
    font-size: 0.76rem;
    line-height: 1.65;
  }

  .footer-mark {
    margin: 0 0 0.65rem;
    color: #b28c59;
  }

  .site-footer p {
    max-width: 48ch;
    margin-top: 0;
  }

  .site-footer a {
    color: #c8ad82;
    text-underline-offset: 0.2rem;
  }

  @media (max-width: 820px) {
    .section-heading,
    .paths {
      grid-template-columns: 1fr;
    }

    .section-intro {
      margin-left: 0;
    }

    .paths {
      gap: 2.75rem;
    }

    .paths-copy h2 {
      max-width: 13ch;
    }
  }

  @media (max-width: 620px) {
    .section-shell,
    .site-footer {
      width: min(100% - 1.5rem, 1180px);
    }

    .selected {
      padding-top: 3.7rem;
      padding-bottom: 4.5rem;
    }

    .section-heading {
      margin-bottom: 2rem;
      gap: 1.4rem;
    }

    .card-grid {
      grid-template-columns: 1fr;
    }

    .paths {
      padding-block: 5rem;
    }

    .path-list a,
    .path-placeholder {
      min-height: 80px;
      grid-template-columns: 34px 1fr auto;
      font-size: 1.35rem;
    }

    .path-status {
      max-width: 8ch;
      text-align: right;
    }

    .context {
      width: 100%;
      padding: 4rem 1.5rem;
      grid-template-columns: 1fr;
      border-right: 0;
      border-left: 0;
    }

    .context-mark {
      width: 78px;
    }

    .site-footer {
      margin-top: 5rem;
      align-items: flex-start;
      flex-direction: column;
      gap: 1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .path-list a:hover,
    .path-list a:focus-visible {
      padding-inline: 0.25rem;
    }
  }
</style>
