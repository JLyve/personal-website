---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import ProvisionalEmptyState from '../components/ProvisionalEmptyState.astro';
---

<BaseLayout
  editorial
  title="Projects — Structure preview"
  description="A provisional Projects index. No personal projects or accomplishments are published here."
>
  <Navigation />
  <ProvisionalEmptyState
    eyebrow="Projects · Structure preview"
    title="Projects will arrive with context."
    description="This provisional index is ready for approved work. Nothing is listed until its scope, role, evidence, and wording have been reviewed."
    statusTitle="No projects are published."
    statusDescription="The original Darkness demonstration projects have been removed. This page makes no claims about work, clients, results, or accomplishments."
    structureLabel="Provisional project structure"
    structureItems={['Question or context', 'What was tried', 'Evidence and lessons']}
  />
</BaseLayout>
