---
const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;
const relativePath = currentPath.replace(base.slice(0, -1), '') || '/';

const links = [
  { label: 'Notes', href: `${base}blog/`, active: relativePath.startsWith('/blog') },
  { label: 'Projects', href: `${base}projects/`, active: relativePath.startsWith('/projects') },
  { label: 'About', href: `${base}about/`, active: relativePath.startsWith('/about') },
];
---

<header class="site-header">
  <nav class="nav" aria-label="Primary navigation">
    <a href={base} class:list={['identity', { active: relativePath === '/' }]} aria-label="Not Entirely Unrelated by Jason Lyvers — Home">
      <span class="identity-mark" aria-hidden="true">✦</span>
      <span class="identity-copy">
        <span class="collection-name">Not Entirely Unrelated</span>
        <span class="author-name">Jason Lyvers</span>
      </span>
    </a>

    <div class="nav-links">
      {links.map((link) => (
        <a href={link.href} class:list={['nav-link', { active: link.active }]} aria-current={link.active ? 'page' : undefined}>
          {link.label}
        </a>
      ))}
    </div>

    <button class="mobile-menu-btn" aria-controls="mobile-menu" aria-expanded="false" type="button" id="mobile-menu-btn">
      <span>Menu</span>
      <svg aria-hidden="true" class="icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round">
        <line x1="4" y1="8" x2="20" y2="8"></line>
        <line x1="4" y1="16" x2="20" y2="16"></line>
      </svg>
    </button>
  </nav>

  <div class="mobile-menu" id="mobile-menu" hidden>
    {links.map((link) => (
      <a href={link.href} class:list={['mobile-nav-link', { active: link.active }]} aria-current={link.active ? 'page' : undefined}>
        {link.label}
      </a>
    ))}
  </div>
</header>

<style>
  .site-header { position: fixed; inset: 0 0 auto; z-index: 1000; padding: 0.75rem clamp(1rem, 4vw, 3rem) 0; pointer-events: none; }
  .nav, .mobile-menu { max-width: 1180px; margin: 0 auto; pointer-events: auto; }
  .nav { min-height: 68px; padding: 0.55rem 0.65rem 0.55rem 1rem; display: flex; align-items: center; justify-content: space-between; gap: 1rem; position: relative; z-index: 1; border: 1px solid rgba(205, 170, 112, 0.22); background: rgba(23, 18, 14, 0.88); box-shadow: 0 16px 55px rgba(6, 4, 3, 0.24); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); }
  .identity { min-height: 48px; display: inline-flex; align-items: center; gap: 0.7rem; color: var(--color-text); text-decoration: none; }
  .identity-mark { color: #c7a26c; font-size: 0.75rem; transition: transform 220ms ease; }
  .identity:hover .identity-mark, .identity:focus-visible .identity-mark { transform: rotate(18deg) scale(1.08); }
  .identity-copy { display: grid; line-height: 1.03; }
  .collection-name { font-family: 'Newsreader', Georgia, serif; font-size: 1.08rem; font-weight: 400; letter-spacing: 0.01em; }
  .author-name { margin-top: 0.28rem; color: #ad9d88; font-size: 0.58rem; font-weight: 650; letter-spacing: 0.15em; text-transform: uppercase; }
  .nav-links { display: flex; align-items: center; gap: clamp(0.25rem, 1.4vw, 1rem); }
  .nav-link { min-height: 44px; padding: 0 0.72rem; display: inline-flex; align-items: center; position: relative; color: #baae9d; font-size: 0.82rem; font-weight: 550; text-decoration: none; }
  .nav-link::after { content: ''; height: 1px; position: absolute; right: 0.72rem; bottom: 7px; left: 0.72rem; background: #c7a26c; transform: scaleX(0); transform-origin: left; transition: transform 180ms ease; }
  .nav-link:hover, .nav-link:focus-visible, .nav-link.active { color: #f0e4d2; }
  .nav-link:hover::after, .nav-link:focus-visible::after, .nav-link.active::after { transform: scaleX(1); }
  .mobile-menu-btn { min-width: 76px; min-height: 44px; padding: 0.5rem 0.7rem; display: none; align-items: center; justify-content: center; gap: 0.45rem; border: 1px solid rgba(205, 170, 112, 0.28); border-radius: 0; background: rgba(205, 170, 112, 0.035); color: var(--color-text); cursor: pointer; font: 600 0.78rem/1 var(--font-body); }
  .mobile-menu { margin-top: 0.4rem; padding: 0.45rem; border: 1px solid rgba(205, 170, 112, 0.22); background: #18130f; box-shadow: 0 18px 50px rgba(0, 0, 0, 0.35); }
  .mobile-menu[hidden] { display: none; }
  .mobile-nav-link { min-height: 48px; padding: 0.75rem 1rem; display: flex; align-items: center; color: #c2b4a1; font-size: 0.92rem; font-weight: 500; text-decoration: none; }
  .mobile-nav-link:hover, .mobile-nav-link:focus-visible, .mobile-nav-link.active { background: rgba(205, 170, 112, 0.06); color: #f0e4d2; }
  @media (max-width: 720px) {
    .site-header { padding: 0.6rem 0.75rem 0; }
    .nav { min-height: 64px; padding-left: 0.75rem; }
    .nav-links { display: none; }
    .mobile-menu-btn { display: flex; }
    .collection-name { font-size: 0.98rem; }
  }
  @media (max-width: 370px) {
    .identity { gap: 0.5rem; }
    .collection-name { font-size: 0.9rem; }
    .mobile-menu-btn { min-width: 70px; padding-inline: 0.55rem; }
  }
  @media (prefers-reduced-motion: reduce) { .identity-mark, .nav-link::after { transition: none; } }
</style>

<script>
  const bindMenu = () => {
    const mobileMenuBtn = document.getElementById('mobile-menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');
    if (!(mobileMenuBtn instanceof HTMLButtonElement) || !mobileMenu) return;
    if (mobileMenuBtn.dataset.bound === 'true') return;
    mobileMenuBtn.dataset.bound = 'true';
    const closeMenu = (returnFocus = false) => {
      mobileMenu.hidden = true;
      mobileMenuBtn.setAttribute('aria-expanded', 'false');
      if (returnFocus) mobileMenuBtn.focus();
    };
    mobileMenuBtn.addEventListener('click', () => {
      const willOpen = mobileMenu.hidden;
      mobileMenu.hidden = !willOpen;
      mobileMenuBtn.setAttribute('aria-expanded', String(willOpen));
      if (willOpen) mobileMenu.querySelector<HTMLAnchorElement>('a')?.focus();
    });
    mobileMenu.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => closeMenu()));
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !mobileMenu.hidden) closeMenu(true);
    });
    document.addEventListener('click', (event) => {
      if (mobileMenu.hidden) return;
      if (event.target instanceof Node && !mobileMenu.contains(event.target) && !mobileMenuBtn.contains(event.target)) closeMenu();
    });
    window.matchMedia('(min-width: 721px)').addEventListener('change', (event) => {
      if (event.matches) closeMenu();
    });
  };
  bindMenu();
  document.addEventListener('astro:page-load', bindMenu);
</script>
