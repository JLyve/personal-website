---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import Hero from '../components/Hero.astro';
import CollectionCard from '../components/CollectionCard.astro';
import { getPublishedNotes, getPublishedProjects } from '../utils/content';

type HomepageEntry = {
  kind: 'Note' | 'Project' | 'Reading';
  title: string;
  excerpt: string;
  href?: string | undefined;
  featured?: boolean | undefined;
  placeholder?: boolean | undefined;
};

const base = import.meta.env.BASE_URL;
const reviewExamplesEnabled = import.meta.env.HOMEPAGE_REVIEW_STATE === 'examples';

const notes = (await getPublishedNotes())
  .filter((note) => note.data.homepage)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .map((note): HomepageEntry => ({
    kind: 'Note',
    title: note.data.title,
    excerpt: note.data.description,
    href: `${base}blog/${note.id}/`,
    featured: note.data.homepage === 'featured',
  }));

const projects = (await getPublishedProjects())
  .filter((project) => project.data.homepage)
  .map((project): HomepageEntry => ({
    kind: 'Project',
    title: project.data.title,
    excerpt: project.data.description,
    href: project.data.link ?? project.data.github,
    featured: project.data.homepage === 'featured',
  }));

let collectionEntries: HomepageEntry[] = [...notes, ...projects];

if (reviewExamplesEnabled) {
  const { homepagePreviewEntries } = await import('../fixtures/homepagePreview');
  collectionEntries = homepagePreviewEntries;
}

const firstEntry = collectionEntries[0];
if (firstEntry && !collectionEntries.some((entry) => entry.featured)) {
  collectionEntries[0] = { ...firstEntry, featured: true };
}

const featuredEntry = collectionEntries.find((entry) => entry.featured);
const supportingEntries = collectionEntries.filter((entry) => entry !== featuredEntry);
---

<BaseLayout editorial title="Not Entirely Unrelated by Jason Lyvers — Homepage preview" description="A review-only homepage preview for Jason Lyvers’s personal collection. The name and welcome wording remain provisional.">
  <Navigation />
  <main class="collection-home">
    <Hero showPortraitPlaceholder={reviewExamplesEnabled} />

    {featuredEntry ? (
      <section class="collection section-shell" aria-labelledby="collection-title">
        <header class="section-heading">
          <div>
            <p class="section-kicker">A considered selection</p>
            <h2 id="collection-title">From the collection</h2>
          </div>
          {reviewExamplesEnabled && (
            <p class="review-note"><strong>Layout examples:</strong> these bracketed placeholders demonstrate hierarchy only. They are not published work.</p>
          )}
        </header>

        <div class="collection-layout">
          <CollectionCard {...featuredEntry} featured />
          {supportingEntries.length > 0 && (
            <div class="supporting-grid">
              {supportingEntries.map((entry) => <CollectionCard {...entry} />)}
            </div>
          )}
        </div>
      </section>
    ) : (
      <section class="quiet-empty section-shell" aria-labelledby="empty-title">
        <p class="section-kicker">The shelves are being arranged</p>
        <h2 id="empty-title">The collection is taking shape.</h2>
        <p>Nothing has been published here yet. The welcome can stand on its own while the first pieces are prepared with care.</p>
        <span class="quiet-mark" aria-hidden="true">✦</span>
      </section>
    )}
  </main>

  <footer class="site-footer">
    <p><span aria-hidden="true">✦</span> Not Entirely Unrelated is a provisional name for this review.</p>
    <p>Built from the open-source <a href="https://github.com/kpab/astro-darkness">Darkness Astro theme</a> by kpab.</p>
  </footer>
</BaseLayout>

<style>
  .collection-home { color: var(--color-text); }
  .section-shell, .site-footer { width: min(100% - 2rem, 1120px); margin-inline: auto; }
  .section-kicker { margin: 0 0 0.85rem; color: #bd9966; font-size: 0.68rem; font-weight: 650; letter-spacing: 0.17em; text-transform: uppercase; }
  h2 { margin: 0; color: var(--color-text); font-family: 'Newsreader', Georgia, serif; font-size: clamp(2.7rem, 6.6vw, 5rem); font-weight: 300; letter-spacing: -0.04em; line-height: 0.98; text-wrap: balance; }
  .collection { padding: clamp(4rem, 7vw, 6.25rem) 0 clamp(5rem, 9vw, 8rem); border-top: 1px solid rgba(205, 170, 112, 0.15); }
  .section-heading { margin-bottom: clamp(2.2rem, 4vw, 3.3rem); display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(270px, 0.75fr); align-items: end; gap: 2rem; }
  .review-note { max-width: 46ch; margin: 0 0 0.2rem auto; color: #a99d8d; font-size: 0.78rem; line-height: 1.7; }
  .review-note strong { color: #d1b382; font-weight: 600; }
  .collection-layout { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(300px, 0.75fr); gap: 1rem; }
  .supporting-grid { display: grid; grid-template-columns: 1fr; gap: 1rem; }
  .quiet-empty { margin-bottom: clamp(4rem, 9vw, 7rem); padding: clamp(3.5rem, 7vw, 5.5rem) clamp(1.4rem, 5vw, 4rem); position: relative; overflow: hidden; border: 1px solid rgba(205, 170, 112, 0.15); background: rgba(31, 24, 19, 0.42); }
  .quiet-empty h2 { max-width: 12ch; font-size: clamp(2.5rem, 5.6vw, 4.3rem); }
  .quiet-empty > p:not(.section-kicker) { max-width: 57ch; margin: 1.3rem 0 0; color: var(--color-text-dim); font-size: 0.95rem; line-height: 1.75; }
  .quiet-mark { position: absolute; right: clamp(1.5rem, 6vw, 5rem); bottom: clamp(1.5rem, 5vw, 3.5rem); color: rgba(205, 170, 112, 0.25); font-size: 0.75rem; }
  .site-footer { padding: 2rem 0 2.6rem; display: flex; justify-content: space-between; gap: 2rem; border-top: 1px solid rgba(205, 170, 112, 0.15); color: #a99f91; font-size: 0.72rem; line-height: 1.65; }
  .site-footer p { max-width: 54ch; margin: 0; }
  .site-footer p:first-child span { margin-right: 0.4rem; color: #bd9966; }
  .site-footer a { color: #ccb184; text-underline-offset: 0.2rem; }
  @media (max-width: 820px) {
    .section-heading, .collection-layout { grid-template-columns: 1fr; }
    .review-note { margin-left: 0; }
    .supporting-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 600px) {
    .section-shell, .site-footer { width: min(100% - 1.5rem, 1120px); }
    .collection { padding-top: 3.5rem; padding-bottom: 5rem; }
    .supporting-grid { grid-template-columns: 1fr; }
    .quiet-empty { padding: 2.25rem 1.35rem 4.5rem; }
    .site-footer { flex-direction: column; gap: 0.7rem; }
  }
</style>
