---
const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;
const relativePath = currentPath.replace(base.slice(0, -1), '') || '/';

const links = [
  { label: 'Notes', href: `${base}blog/`, active: relativePath.startsWith('/blog') },
  { label: 'Projects', href: `${base}projects/`, active: relativePath.startsWith('/projects') },
  { label: 'Reading', href: `${base}#reading`, active: false },
  { label: 'About', href: `${base}about/`, active: relativePath.startsWith('/about') },
];
---

<header class="site-header">
  <nav class="nav" aria-label="Primary navigation">
    <a href={base} class:list={['logo', { active: relativePath === '/' }]} aria-label="Home — The Curiosity Engine, working title">
      <span class="logo-mark" aria-hidden="true">✦</span>
      <span class="logo-copy">
        <span class="logo-name">The Curiosity Engine</span>
        <span class="logo-status">working title</span>
      </span>
    </a>

    <div class="nav-links">
      {links.map((link) => (
        <a href={link.href} class:list={['nav-link', { active: link.active }]} aria-current={link.active ? 'page' : undefined}>
          {link.label}
        </a>
      ))}
    </div>

    <button
      class="mobile-menu-btn"
      aria-controls="mobile-menu"
      aria-expanded="false"
      type="button"
      id="mobile-menu-btn"
    >
      <span>Menu</span>
      <svg aria-hidden="true" class="icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round">
        <line x1="4" y1="8" x2="20" y2="8"></line>
        <line x1="4" y1="16" x2="20" y2="16"></line>
      </svg>
    </button>
  </nav>

  <div class="mobile-menu" id="mobile-menu" hidden>
    {links.map((link) => (
      <a href={link.href} class:list={['mobile-nav-link', { active: link.active }]} aria-current={link.active ? 'page' : undefined}>
        {link.label}
      </a>
    ))}
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    padding: 0.8rem clamp(1rem, 4vw, 3rem) 0;
    pointer-events: none;
  }

  .nav,
  .mobile-menu {
    max-width: 1180px;
    margin: 0 auto;
    pointer-events: auto;
  }

  .nav {
    min-height: 64px;
    padding: 0.55rem 0.7rem 0.55rem 1rem;
    position: relative;
    z-index: 1;
    background: rgba(15, 23, 42, 0.86);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    animation: slideDown 0.5s ease-out;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .logo {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    text-decoration: none;
    color: var(--color-text);
    transition: color 0.2s ease;
  }

  .logo-mark {
    color: var(--color-primary);
    font-size: 0.85rem;
  }

  .logo-copy {
    display: grid;
    line-height: 1.05;
  }

  .logo-name {
    font-family: var(--font-heading);
    font-size: 1.12rem;
    font-weight: 500;
    letter-spacing: 0.01em;
  }

  .logo-status {
    margin-top: 0.2rem;
    color: var(--color-text-dim);
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .logo:hover {
    color: var(--color-primary);
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: clamp(0.4rem, 1.4vw, 1.2rem);
  }

  .nav-link {
    min-height: 44px;
    padding: 0 0.65rem;
    display: inline-flex;
    align-items: center;
    color: var(--color-text-dim);
    text-decoration: none;
    font-weight: 500;
    font-size: 0.9rem;
    position: relative;
    transition: color 0.2s ease;
    cursor: pointer;
  }

  .nav-link::after {
    content: '';
    position: absolute;
    bottom: 6px;
    left: 0.65rem;
    width: 0;
    height: 2px;
    background: var(--color-primary);
    transition: width 0.2s ease;
  }

  .nav-link:hover {
    color: var(--color-text);
  }

  .nav-link:hover::after,
  .nav-link.active::after {
    width: calc(100% - 1.3rem);
  }

  .nav-link.active {
    color: var(--color-primary);
  }

  .mobile-menu-btn {
    display: none;
    min-width: 76px;
    min-height: 44px;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    color: var(--color-text);
    cursor: pointer;
    padding: 0.5rem 0.7rem;
    font: 600 0.82rem/1 var(--font-body);
  }

  .mobile-menu {
    margin-top: 0.45rem;
    padding: 0.5rem;
    background: rgba(15, 23, 42, 0.97);
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    box-shadow: 0 18px 50px rgba(0, 0, 0, 0.35);
  }

  .mobile-menu[hidden] {
    display: none;
  }

  .mobile-nav-link {
    min-height: 48px;
    padding: 0.75rem 1rem;
    display: flex;
    align-items: center;
    border-radius: 0.45rem;
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--color-text-dim);
    text-decoration: none;
    transition: color 0.2s ease, background 0.2s ease;
  }

  .mobile-nav-link:hover,
  .mobile-nav-link.active {
    color: var(--color-primary);
    background: rgba(255, 255, 255, 0.035);
  }

  :global(body.editorial-page) .nav,
  :global(body.editorial-page) .mobile-menu {
    background: rgba(24, 19, 15, 0.88);
    box-shadow: 0 16px 55px rgba(6, 4, 3, 0.24);
  }

  :global(body.editorial-page) .mobile-menu {
    background: #18130f;
  }

  @keyframes slideDown {
    from {
      transform: translateY(-100%);
      opacity: 0;
    }
    to {
      transform: translateY(0);
      opacity: 1;
    }
  }

  @media (max-width: 720px) {
    .site-header {
      padding: 0.65rem 0.75rem 0;
    }

    .nav-links {
      display: none;
    }

    .mobile-menu-btn {
      display: flex;
    }
  }

  @media (max-width: 360px) {
    .logo-name {
      font-size: 1rem;
    }
  }
</style>

<script>
  const bindMenu = () => {
    const mobileMenuBtn = document.getElementById('mobile-menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');

    if (!(mobileMenuBtn instanceof HTMLButtonElement) || !mobileMenu) return;
    if (mobileMenuBtn.dataset.bound === 'true') return;
    mobileMenuBtn.dataset.bound = 'true';

    const closeMenu = (returnFocus = false) => {
      mobileMenu.hidden = true;
      mobileMenuBtn.setAttribute('aria-expanded', 'false');
      if (returnFocus) mobileMenuBtn.focus();
    };

    mobileMenuBtn.addEventListener('click', () => {
      const willOpen = mobileMenu.hidden;
      mobileMenu.hidden = !willOpen;
      mobileMenuBtn.setAttribute('aria-expanded', String(willOpen));
      if (willOpen) mobileMenu.querySelector<HTMLAnchorElement>('a')?.focus();
    });

    mobileMenu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => closeMenu());
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !mobileMenu.hidden) closeMenu(true);
    });

    window.matchMedia('(min-width: 721px)').addEventListener('change', (event) => {
      if (event.matches) closeMenu();
    });
  };

  bindMenu();
  document.addEventListener('astro:page-load', bindMenu);
</script>
