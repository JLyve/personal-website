---
interface Props {
  kind: string;
  title: string;
  description: string;
  href: string;
  action: string;
}

const { kind, title, description, href, action } = Astro.props;
---

<article class="editorial-card">
  <a href={href} aria-label={`${title}: ${action}`}>
    <span class="card-glint" aria-hidden="true">✦</span>
    <span class="kind">{kind}</span>
    <h3>{title}</h3>
    <p>{description}</p>
    <span class="action">
      {action}
      <svg aria-hidden="true" width="16" height="12" viewBox="0 0 16 12" fill="none">
        <path d="M1 6h13M10 2l4 4-4 4" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </span>
    <span class="geometry" aria-hidden="true"></span>
  </a>
</article>

<style>
  .editorial-card,
  .editorial-card a {
    height: 100%;
  }

  .editorial-card a {
    min-height: 330px;
    padding: clamp(1.5rem, 3.4vw, 2.5rem);
    display: flex;
    flex-direction: column;
    position: relative;
    overflow: hidden;
    border: 1px solid rgba(205, 170, 112, 0.2);
    border-radius: 0.2rem;
    background: linear-gradient(145deg, rgba(39, 31, 24, 0.76), rgba(27, 22, 18, 0.72));
    color: var(--color-text);
    text-decoration: none;
    transition: border-color 220ms ease, background 220ms ease, transform 220ms ease;
  }

  .editorial-card a::before {
    content: '';
    width: 35%;
    height: 1px;
    position: absolute;
    top: 0;
    left: 0;
    background: linear-gradient(90deg, #ca9e65, transparent);
    opacity: 0.65;
  }

  .kind {
    margin-bottom: 3rem;
    color: #bc9b6b;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  h3 {
    max-width: 16ch;
    margin: 0;
    color: var(--color-text);
    font-family: 'Newsreader', Georgia, serif;
    font-size: clamp(1.9rem, 3.5vw, 2.75rem);
    font-weight: 400;
    letter-spacing: -0.025em;
    line-height: 1.08;
  }

  p {
    max-width: 40ch;
    margin: 1.15rem 0 2rem;
    color: var(--color-text-dim);
    font-size: 0.94rem;
    line-height: 1.7;
  }

  .action {
    min-height: 44px;
    margin-top: auto;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: #d5b884;
    font-size: 0.83rem;
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  .card-glint {
    position: absolute;
    top: 1.35rem;
    right: 1.35rem;
    color: #d6b477;
    font-size: 0.72rem;
    opacity: 0.18;
    transform: scale(0.8) rotate(0);
    transition: opacity 220ms ease, transform 320ms ease;
  }

  .geometry {
    width: 82px;
    height: 82px;
    position: absolute;
    right: -34px;
    bottom: -31px;
    border: 1px solid rgba(205, 170, 112, 0.035);
    border-radius: 50%;
    transition: border-color 220ms ease, transform 500ms ease;
  }

  .geometry::before,
  .geometry::after {
    content: '';
    position: absolute;
    inset: 20px;
    border: 1px solid rgba(205, 170, 112, 0.028);
    transform: rotate(45deg);
  }

  .geometry::after {
    inset: 32px;
    border-radius: 50%;
  }

  .editorial-card a:hover,
  .editorial-card a:focus-visible {
    border-color: rgba(205, 170, 112, 0.48);
    background: linear-gradient(145deg, rgba(46, 36, 27, 0.9), rgba(28, 23, 18, 0.82));
    transform: translateY(-3px);
  }

  .editorial-card a:hover .card-glint,
  .editorial-card a:focus-visible .card-glint {
    opacity: 0.9;
    transform: scale(1.15) rotate(24deg);
  }

  .editorial-card a:hover .geometry,
  .editorial-card a:focus-visible .geometry {
    border-color: rgba(205, 170, 112, 0.11);
    transform: rotate(12deg) scale(1.04);
  }

  @media (max-width: 720px) {
    .editorial-card a {
      min-height: 290px;
    }

    .kind {
      margin-bottom: 2rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .editorial-card a:hover,
    .editorial-card a:focus-visible,
    .editorial-card a:hover .geometry,
    .editorial-card a:focus-visible .geometry {
      transform: none;
    }
  }
</style>
