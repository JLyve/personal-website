---
import BaseLayout from './BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import '../styles/magnolia-deep-note-preview.css';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date | undefined;
  author: string;
  format: 'Field Note' | 'Deep Note' | 'Experiment';
  tags?: string[] | undefined;
  magnoliaPreview?: boolean;
}

const base = import.meta.env.BASE_URL;
const { title, description, pubDate, updatedDate, author, format, tags, magnoliaPreview } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site).toString();

const formattedPubDate = pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});

const formattedUpdatedDate = updatedDate?.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  articleSection: format,
  author: {
    '@type': 'Person',
    name: author,
  },
  datePublished: pubDate.toISOString(),
  ...(updatedDate ? { dateModified: updatedDate.toISOString() } : {}),
  mainEntityOfPage: canonicalURL,
  ...(tags?.length ? { keywords: tags } : {}),
};
---

<BaseLayout editorial title={`${title} | Notes`} description={description}>
  <Navigation />
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <article class:list={['blog-post', { 'magnolia-deep-note-preview': magnoliaPreview }]}>
    <div class="container">
      <header class="post-header">
        <a href={`${base}blog/`} class="back-link">← Back to Notes</a>
        <p class="post-format">{format}</p>
        <h1 class="post-title">{title}</h1>
        <p class="post-description">{description}</p>
        <div class="post-meta">
          <span>By {author}</span>
          <span aria-hidden="true">·</span>
          <time datetime={pubDate.toISOString()}>{formattedPubDate}</time>
          {formattedUpdatedDate && (
            <>
              <span aria-hidden="true">·</span>
              <span>Updated {formattedUpdatedDate}</span>
            </>
          )}
        </div>
        {tags && tags.length > 0 && (
          <p class="post-topics">Topics: {tags.join(', ')}</p>
        )}
      </header>

      <div class="post-content">
        <slot />
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .blog-post {
    min-height: 100svh;
    padding: clamp(7.5rem, 13vw, 9.25rem) clamp(1rem, 4vw, 2rem) clamp(4rem, 8vw, 7rem);
  }

  .container {
    max-width: 760px;
    margin: 0 auto;
  }

  .post-header {
    margin-bottom: clamp(3rem, 7vw, 5rem);
  }

  .back-link {
    min-height: 44px;
    margin-bottom: clamp(2.5rem, 6vw, 4.5rem);
    display: inline-flex;
    align-items: center;
    color: #c8aa78;
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    text-decoration: none;
  }

  .back-link:hover,
  .back-link:focus-visible {
    color: #f0dfc4;
  }

  .post-format {
    margin: 0 0 1rem;
    color: #c4a16d;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.17em;
    text-transform: uppercase;
  }

  .post-title {
    max-width: 15ch;
    margin: 0;
    color: var(--color-text);
    font-family: 'Newsreader', Georgia, serif;
    font-size: clamp(2.9rem, 8vw, 5.4rem);
    font-weight: 300;
    letter-spacing: -0.045em;
    line-height: 0.98;
    text-wrap: balance;
  }

  .post-description {
    max-width: 55ch;
    margin: 1.5rem 0 0;
    color: #d2c4b1;
    font-size: clamp(1.03rem, 2vw, 1.17rem);
    line-height: 1.7;
  }

  .post-meta {
    margin-top: 2rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.5rem;
    color: #aa9d8c;
    font-size: 0.875rem;
  }

  .post-topics {
    margin: 0.8rem 0 0;
    color: #aa9d8c;
    font-size: 0.82rem;
  }

  .post-content {
    padding-top: clamp(2.75rem, 6vw, 4rem);
    border-top: 1px solid rgba(205, 170, 112, 0.2);
  }

  .post-content :global(h2),
  .post-content :global(h3),
  .post-content :global(h4) {
    color: var(--color-text);
    font-family: 'Newsreader', Georgia, serif;
    font-weight: 400;
    text-wrap: balance;
  }

  .post-content :global(h2) {
    margin: clamp(3.8rem, 8vw, 5.5rem) 0 1.4rem;
    font-size: clamp(2rem, 5vw, 2.65rem);
    letter-spacing: -0.025em;
    line-height: 1.08;
  }

  .post-content :global(h3) {
    margin: 3rem 0 1.2rem;
    font-size: clamp(1.55rem, 4vw, 1.9rem);
    line-height: 1.15;
  }

  .post-content :global(p) {
    margin: 0 0 1.45rem;
    color: #d2c6b5;
    font-size: clamp(1rem, 1.7vw, 1.08rem);
    line-height: 1.82;
  }

  .post-content > :global(p:first-child) {
    color: #eadfce;
    font-size: clamp(1.08rem, 2vw, 1.18rem);
  }

  .post-content :global(a) {
    color: #dfbd84;
    text-decoration-color: rgba(223, 189, 132, 0.55);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
  }

  .post-content :global(a:hover),
  .post-content :global(a:focus-visible) {
    color: #f3d7a8;
    text-decoration-color: currentColor;
  }

  .post-content :global(code) {
    background: rgba(205, 170, 112, 0.1);
    padding: 0.2rem 0.4rem;
    border-radius: 0.25rem;
    font-family: 'Courier New', monospace;
    font-size: 0.9em;
    color: #dfbd84;
  }

  .post-content :global(pre) {
    background: var(--color-bg-darker);
    border: 1px solid rgba(205, 170, 112, 0.24);
    border-radius: 0.5rem;
    padding: 1.5rem;
    overflow-x: auto;
    margin: 1.5rem 0;
  }

  .post-content :global(pre code) {
    background: none;
    padding: 0;
    color: var(--color-text);
  }

  .post-content :global(ul),
  .post-content :global(ol) {
    margin: 1.5rem 0;
    padding-left: 2rem;
    color: var(--color-text-dim);
  }

  .post-content :global(li) {
    margin-bottom: 0.5rem;
    line-height: 1.6;
  }

  .post-content :global(blockquote) {
    border-left: 3px solid #b9915d;
    padding-left: 1.5rem;
    margin: 1.5rem 0;
    font-style: italic;
    color: var(--color-text-dim);
  }

  @media (max-width: 520px) {
    .post-title {
      font-size: clamp(2.65rem, 13vw, 3.7rem);
    }

    .post-meta {
      gap: 0.45rem 0.8rem;
    }
  }
</style>
