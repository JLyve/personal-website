---
interface Props {
  portraitSrc?: string;
}

const { portraitSrc } = Astro.props;
---

<section class="welcome" aria-labelledby="welcome-title">
  <div class="alchemy-atmosphere" aria-hidden="true">
    <svg viewBox="0 0 260 260" fill="none">
      <g class="slow-orbit">
        <circle cx="130" cy="130" r="76" />
        <ellipse cx="130" cy="130" rx="112" ry="45" transform="rotate(-28 130 130)" />
        <path d="M130 44 205 174H55L130 44Z" />
        <path d="m130 82 48 48-48 48-48-48 48-48Z" />
      </g>
      <path class="fine-line" d="M18 130h224M130 18v224" />
      <circle class="center-point" cx="130" cy="130" r="3" />
      <circle class="wandering-point" cx="218" cy="78" r="2" />
    </svg>
    <span class="field-glyph glyph-one">✦</span>
    <span class="field-glyph glyph-two">◇</span>
  </div>

  {portraitSrc && (
    <div class="portrait-placement">
      <img
        class="portrait-image"
        src={portraitSrc}
        alt="Jason Lyvers"
        width="320"
        height="320"
        decoding="async"
      />
    </div>
  )}

  <div class="welcome-copy">
    <p class="preview-label">A brief welcome <span aria-hidden="true">·</span> provisional wording</p>
    <h1 id="welcome-title">
      I’m Jason Lyvers. I work in digital marketing. That explains some of what you’ll find here.
    </h1>
    <p>
      The rest involves books, questions, experiments, and connections I’m still trying to explain. Have a look around.
    </p>
  </div>
</section>

<style>
  .welcome {
    min-width: 0;
    padding: 0.6rem 0 2.4rem;
    position: relative;
    isolation: isolate;
  }

  .welcome::after {
    content: '✦';
    position: absolute;
    left: 0;
    bottom: 0;
    color: rgba(207, 167, 104, 0.65);
    font-size: 0.62rem;
    text-shadow: 0 0 18px rgba(196, 155, 99, 0.45);
  }

  .welcome-copy {
    max-width: 630px;
    position: relative;
    z-index: 1;
  }

  .portrait-placement {
    margin-bottom: 1.35rem;
    position: relative;
    z-index: 1;
  }

  .portrait-image {
    width: 88px;
    height: 88px;
    display: block;
  }

  .preview-label {
    margin: 0 0 1.15rem;
    color: #bd9966;
    font-size: 0.66rem;
    font-weight: 650;
    letter-spacing: 0.17em;
    line-height: 1.5;
    text-transform: uppercase;
  }

  h1 {
    max-width: 23ch;
    margin: 0;
    color: var(--color-text);
    font-family: 'Newsreader', Georgia, serif;
    font-size: clamp(1.75rem, 2.7vw, 2.35rem);
    font-weight: 350;
    letter-spacing: -0.024em;
    line-height: 1.13;
    text-wrap: balance;
  }

  .welcome-copy > p:last-child {
    max-width: 52ch;
    margin: 1.15rem 0 0;
    color: var(--color-text-dim);
    font-size: clamp(0.93rem, 1.15vw, 1rem);
    line-height: 1.72;
  }

  .alchemy-atmosphere {
    width: min(104px, calc(var(--opening-gap, 5rem) - 16px));
    aspect-ratio: 1;
    position: absolute;
    right: calc(var(--opening-gap, 5rem) / -2);
    top: 54%;
    z-index: -1;
    color: #c39a61;
    opacity: 0.28;
    pointer-events: none;
    transform: translate(50%, -50%);
  }

  .alchemy-atmosphere svg {
    width: 100%;
    height: 100%;
    overflow: visible;
    stroke: currentColor;
    stroke-width: 0.65;
  }

  .slow-orbit {
    transform-origin: 130px 130px;
    animation: alchemy-turn 36s linear infinite;
  }

  .fine-line {
    opacity: 0.24;
    stroke-dasharray: 1 9;
  }

  .center-point,
  .wandering-point {
    fill: #d9b578;
    stroke: none;
    filter: drop-shadow(0 0 8px rgba(217, 181, 120, 0.8));
  }

  .field-glyph {
    position: absolute;
    color: #d9b578;
    line-height: 1;
  }

  .glyph-one { top: 8%; right: 14%; font-size: 0.68rem; }
  .glyph-two { left: 4%; bottom: 17%; font-size: 0.8rem; opacity: 0.68; }

  @keyframes alchemy-turn {
    to { transform: rotate(360deg); }
  }

  @media (max-width: 860px) {
    .alchemy-atmosphere { display: none; }
  }

  @media (max-width: 720px) {
    .welcome {
      padding-top: 0;
      padding-bottom: 2.25rem;
    }

    h1 {
      max-width: 24ch;
      font-size: clamp(1.72rem, 7.6vw, 2.05rem);
      line-height: 1.13;
    }

    .portrait-placement { margin-bottom: 1.1rem; }
    .portrait-image { width: 68px; height: 68px; }
  }

  @media (max-width: 370px) {
    h1 { font-size: 1.68rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .slow-orbit { animation: none; }
  }
</style>
