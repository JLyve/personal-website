---
import { existsSync, readdirSync } from 'node:fs';
import { getCollection, render } from 'astro:content';
import BlogPostLayout from '../../layouts/BlogPostLayout.astro';

export async function getStaticPaths() {
  const blogDirectory = new URL('../../content/blog', import.meta.url);
  const hasApprovedEntries =
    existsSync(blogDirectory) &&
    readdirSync(blogDirectory, { recursive: true }).some((file) => /\.mdx?$/.test(String(file)));

  if (!hasApprovedEntries) return [];

  const blogEntries = await getCollection('blog');
  return blogEntries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<BlogPostLayout
  title={entry.data.title}
  description={entry.data.description}
  pubDate={entry.data.pubDate}
  updatedDate={entry.data.updatedDate}
  tags={entry.data.tags}
>
  <Content />
</BlogPostLayout>
