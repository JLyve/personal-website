---
interface Props {
  showPortraitPlaceholder?: boolean;
}

const { showPortraitPlaceholder = false } = Astro.props;
---

<section class:list={['welcome', { 'with-portrait': showPortraitPlaceholder }]} aria-labelledby="welcome-title">
  <div class="welcome-copy">
    <p class="preview-label">Homepage preview <span aria-hidden="true">·</span> provisional wording</p>
    <h1 id="welcome-title">
      I’m Jason Lyvers. I work in digital marketing. That explains some of what you’ll find here.
    </h1>
    <p>
      The rest involves books, questions, experiments, and connections I’m still trying to explain. Have a look around.
    </p>
  </div>

  {showPortraitPlaceholder && (
    <aside class="portrait-placeholder" aria-label="Portrait placement for review">
      <div class="portrait-frame" aria-hidden="true">
        <span class="portrait-mark">JL</span>
        <span class="portrait-orbit"></span>
      </div>
      <p><strong>Portrait placement</strong><span>No photograph selected</span></p>
    </aside>
  )}
</section>

<style>
  .welcome {
    width: min(100% - 2rem, 1120px);
    min-height: 0;
    margin: 0 auto;
    padding: clamp(9.5rem, 18vh, 12rem) 0 clamp(4rem, 8vw, 6.75rem);
    display: grid;
    align-items: center;
    position: relative;
  }

  .welcome::after {
    content: '';
    width: 4px;
    height: 4px;
    position: absolute;
    right: 2%;
    bottom: 24%;
    border-radius: 50%;
    background: #c49b63;
    box-shadow: 0 0 18px rgba(196, 155, 99, 0.35);
    opacity: 0.65;
  }

  .welcome.with-portrait {
    grid-template-columns: minmax(0, 1fr) minmax(190px, 242px);
    gap: clamp(3rem, 9vw, 7rem);
  }

  .welcome-copy {
    max-width: 790px;
  }

  .preview-label {
    margin: 0 0 1.25rem;
    color: #bd9966;
    font-size: 0.68rem;
    font-weight: 650;
    letter-spacing: 0.17em;
    line-height: 1.5;
    text-transform: uppercase;
  }

  h1 {
    max-width: 19ch;
    margin: 0;
    color: var(--color-text);
    font-family: 'Newsreader', Georgia, serif;
    font-size: clamp(2.55rem, 5.6vw, 4.85rem);
    font-weight: 300;
    letter-spacing: -0.038em;
    line-height: 1.02;
    text-wrap: balance;
  }

  .welcome-copy > p:last-child {
    max-width: 57ch;
    margin: 1.6rem 0 0;
    color: var(--color-text-dim);
    font-size: clamp(1rem, 1.5vw, 1.12rem);
    line-height: 1.78;
  }

  .portrait-placeholder {
    width: 100%;
    margin-top: 0.75rem;
  }

  .portrait-frame {
    aspect-ratio: 4 / 5;
    display: grid;
    place-items: center;
    position: relative;
    overflow: hidden;
    border: 1px solid rgba(205, 170, 112, 0.26);
    background: linear-gradient(145deg, rgba(52, 40, 29, 0.68), rgba(24, 19, 15, 0.82)), #211a14;
  }

  .portrait-frame::before,
  .portrait-frame::after,
  .portrait-orbit {
    content: '';
    position: absolute;
    border: 1px solid rgba(205, 170, 112, 0.1);
    border-radius: 50%;
  }

  .portrait-frame::before {
    width: 64%;
    aspect-ratio: 1;
  }

  .portrait-frame::after {
    width: 84%;
    aspect-ratio: 1;
    transform: translate(34%, 45%);
  }

  .portrait-orbit {
    width: 55%;
    aspect-ratio: 1;
    transform: rotate(45deg);
    border-radius: 0;
    opacity: 0.55;
  }

  .portrait-mark {
    color: #d4b681;
    font-family: 'Newsreader', Georgia, serif;
    font-size: 2rem;
    font-weight: 300;
    letter-spacing: 0.06em;
  }

  .portrait-placeholder > p {
    margin: 0.9rem 0 0;
    display: grid;
    gap: 0.2rem;
    color: #a99a87;
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    line-height: 1.5;
    text-transform: uppercase;
  }

  .portrait-placeholder strong {
    color: #d1b382;
    font-weight: 600;
  }

  @media (max-width: 720px) {
    .welcome,
    .welcome.with-portrait {
      width: min(100% - 1.5rem, 1120px);
      padding-top: 8.25rem;
      padding-bottom: 3.75rem;
      grid-template-columns: 1fr;
      gap: 2.75rem;
    }

    h1 {
      max-width: 18ch;
      font-size: clamp(2.45rem, 11.5vw, 3.5rem);
      line-height: 1.01;
    }

    .portrait-placeholder {
      width: min(56vw, 190px);
      margin: 0;
    }

    .welcome::after {
      display: none;
    }
  }

  @media (max-width: 370px) {
    h1 {
      font-size: 2.35rem;
    }
  }
</style>
