---
interface Props {
  eyebrow: string;
  title: string;
  description: string;
  statusTitle: string;
  statusDescription: string;
  structureLabel: string;
  structureItems: string[];
}

const {
  eyebrow,
  title,
  description,
  statusTitle,
  statusDescription,
  structureLabel,
  structureItems,
} = Astro.props;

const base = import.meta.env.BASE_URL;
---

<main class="provisional-page">
  <div class="page-shell">
    <header class="page-intro">
      <p class="eyebrow">{eyebrow} <span aria-hidden="true">·</span> provisional copy</p>
      <h1>{title}</h1>
      <p class="description">{description}</p>
    </header>

    <section class="empty-panel" aria-labelledby="status-title">
      <div class="status-copy">
        <p class="panel-label">Current status</p>
        <h2 id="status-title">{statusTitle}</h2>
        <p>{statusDescription}</p>
        <a href={base}>
          Return to the homepage preview
          <svg aria-hidden="true" width="16" height="12" viewBox="0 0 16 12" fill="none">
            <path d="M1 6h13M10 2l4 4-4 4" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
      </div>

      <div class="structure" aria-label={structureLabel}>
        <p class="panel-label">{structureLabel}</p>
        <ul>
          {structureItems.map((item, index) => (
            <li>
              <span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
              {item}
            </li>
          ))}
        </ul>
      </div>

      <span class="panel-glint" aria-hidden="true">✦</span>
      <span class="panel-geometry" aria-hidden="true"></span>
    </section>
  </div>
</main>

<footer class="empty-footer">
  <p>Structure preview. No private drafts or unapproved personal content are included.</p>
  <p>Built from the open-source <a href="https://github.com/kpab/astro-darkness">Darkness Astro theme</a> by kpab.</p>
</footer>

<style>
  .provisional-page,
  .empty-footer {
    width: min(100% - 2rem, 1180px);
    margin-inline: auto;
  }

  .provisional-page {
    min-height: calc(100svh - 108px);
    padding: clamp(8rem, 15vh, 9.5rem) 0 clamp(3.5rem, 7vw, 5.5rem);
    color: var(--color-text);
  }

  .page-intro {
    max-width: 850px;
  }

  .eyebrow,
  .panel-label {
    color: #c4a16d;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.17em;
    line-height: 1.5;
    text-transform: uppercase;
  }

  .eyebrow {
    margin: 0 0 1.2rem;
  }

  h1,
  h2 {
    margin: 0;
    color: var(--color-text);
    font-family: 'Newsreader', Georgia, serif;
    font-weight: 300;
    text-wrap: balance;
  }

  h1 {
    max-width: 13ch;
    font-size: clamp(3.5rem, 8vw, 6.5rem);
    letter-spacing: -0.045em;
    line-height: 0.94;
  }

  .description {
    max-width: 58ch;
    margin: 1.5rem 0 0;
    color: var(--color-text-dim);
    font-size: clamp(0.98rem, 1.4vw, 1.08rem);
    line-height: 1.75;
  }

  .empty-panel {
    margin-top: clamp(3rem, 6vw, 5rem);
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(300px, 0.85fr);
    position: relative;
    overflow: hidden;
    border: 1px solid rgba(205, 170, 112, 0.2);
    background: rgba(34, 27, 21, 0.52);
  }

  .status-copy,
  .structure {
    padding: clamp(1.7rem, 4vw, 3.25rem);
  }

  .status-copy {
    border-right: 1px solid rgba(205, 170, 112, 0.15);
  }

  .panel-label {
    margin: 0 0 1.15rem;
  }

  h2 {
    max-width: 14ch;
    font-size: clamp(2.15rem, 4vw, 3.4rem);
    letter-spacing: -0.035em;
    line-height: 1;
  }

  .status-copy > p:not(.panel-label) {
    max-width: 48ch;
    margin: 1.2rem 0 0;
    color: var(--color-text-dim);
    font-size: 0.96rem;
    line-height: 1.75;
  }

  .status-copy a {
    min-height: 44px;
    margin-top: 1.6rem;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: #d8ba85;
    font-size: 0.84rem;
    font-weight: 600;
    text-decoration-color: rgba(216, 186, 133, 0.45);
    text-underline-offset: 0.28rem;
  }

  .status-copy a:hover,
  .status-copy a:focus-visible {
    color: #f0d9ae;
  }

  .structure ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .structure li {
    min-height: 58px;
    padding: 0.75rem 0;
    display: grid;
    grid-template-columns: 34px 1fr;
    align-items: center;
    gap: 0.75rem;
    border-top: 1px solid rgba(205, 170, 112, 0.14);
    color: #e3d7c6;
    font-family: 'Newsreader', Georgia, serif;
    font-size: 1.22rem;
    line-height: 1.25;
  }

  .structure li:last-child {
    border-bottom: 1px solid rgba(205, 170, 112, 0.14);
  }

  .structure li span {
    color: #9f8767;
    font-family: 'Manrope', system-ui, sans-serif;
    font-size: 0.64rem;
    font-weight: 600;
    letter-spacing: 0.12em;
  }

  .panel-glint {
    position: absolute;
    top: 1.25rem;
    right: 1.25rem;
    color: rgba(214, 180, 119, 0.42);
    font-size: 0.72rem;
  }

  .panel-geometry {
    width: 88px;
    height: 88px;
    position: absolute;
    right: -38px;
    bottom: -36px;
    border: 1px solid rgba(205, 170, 112, 0.045);
    border-radius: 50%;
  }

  .panel-geometry::before {
    content: '';
    position: absolute;
    inset: 22px;
    border: 1px solid rgba(205, 170, 112, 0.035);
    transform: rotate(45deg);
  }

  .empty-footer {
    padding: 2rem 0 2.5rem;
    display: flex;
    justify-content: space-between;
    gap: 2rem;
    border-top: 1px solid rgba(205, 170, 112, 0.15);
    color: #a9a093;
    font-size: 0.76rem;
    line-height: 1.65;
  }

  .empty-footer p {
    max-width: 52ch;
    margin: 0;
  }

  .empty-footer a {
    color: #ccb184;
    text-underline-offset: 0.2rem;
  }

  @media (max-width: 720px) {
    .provisional-page,
    .empty-footer {
      width: min(100% - 1.5rem, 1180px);
    }

    .provisional-page {
      min-height: auto;
      padding-top: 7.2rem;
      padding-bottom: 3.5rem;
    }

    h1 {
      font-size: clamp(3.2rem, 15vw, 4.6rem);
    }

    .empty-panel {
      margin-top: 2.7rem;
      grid-template-columns: 1fr;
    }

    .status-copy {
      border-right: 0;
      border-bottom: 1px solid rgba(205, 170, 112, 0.15);
    }

    .status-copy,
    .structure {
      padding: 1.5rem;
    }

    .empty-footer {
      flex-direction: column;
      gap: 0.9rem;
    }
  }
</style>
