---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import Hero from '../components/Hero.astro';
import PortraitPlaceholder from '../components/PortraitPlaceholder.astro';
import CollectionCard from '../components/CollectionCard.astro';
import { getPublishedNotes, getPublishedProjects } from '../utils/content';

type HomepageEntry = {
  kind: 'Note' | 'Project' | 'Reading';
  title: string;
  excerpt: string;
  href?: string | undefined;
  featured?: boolean | undefined;
  placeholder?: boolean | undefined;
};

const base = import.meta.env.BASE_URL;
const examplesReviewBranch = 'preview-examples/not-entirely-unrelated-homepage';
const reviewExamplesEnabled =
  import.meta.env.HOMEPAGE_REVIEW_STATE === 'examples' ||
  import.meta.env.CF_PAGES_BRANCH === examplesReviewBranch;

const notes = (await getPublishedNotes())
  .filter((note) => note.data.homepage)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .map((note): HomepageEntry => ({
    kind: 'Note',
    title: note.data.title,
    excerpt: note.data.description,
    href: `${base}blog/${note.id}/`,
    featured: note.data.homepage === 'featured',
  }));

const projects = (await getPublishedProjects())
  .filter((project) => project.data.homepage)
  .map((project): HomepageEntry => ({
    kind: 'Project',
    title: project.data.title,
    excerpt: project.data.description,
    href: project.data.link ?? project.data.github,
    featured: project.data.homepage === 'featured',
  }));

let collectionEntries: HomepageEntry[] = [...notes, ...projects];

if (reviewExamplesEnabled) {
  const { homepagePreviewEntries } = await import('../fixtures/homepagePreview');
  collectionEntries = homepagePreviewEntries;
}

const firstEntry = collectionEntries[0];
if (firstEntry && !collectionEntries.some((entry) => entry.featured)) {
  collectionEntries[0] = { ...firstEntry, featured: true };
}

const featuredEntry = collectionEntries.find((entry) => entry.featured);
const supportingEntries = collectionEntries.filter((entry) => entry !== featuredEntry);
---

<BaseLayout editorial title="Not Entirely Unrelated by Jason Lyvers — Homepage preview" description="A review-only homepage preview for Jason Lyvers’s personal collection. The name and welcome wording remain provisional.">
  <Navigation />

  <main class="collection-home">
    <div class="opening section-shell">
      <div class="welcome-slot">
        <Hero />
      </div>

      {featuredEntry ? (
        <section class="featured-cluster" aria-labelledby="collection-title">
          <header class="featured-heading">
            <div>
              <p class="section-kicker">A considered selection</p>
              <h2 id="collection-title">From the collection</h2>
            </div>
            {reviewExamplesEnabled && (
              <p class="review-note"><strong>Layout example:</strong> this bracketed placeholder demonstrates hierarchy only.</p>
            )}
          </header>
          <CollectionCard {...featuredEntry} featured />
        </section>
      ) : (
        <section class="quiet-empty" aria-labelledby="empty-title">
          <div class="empty-sigil" aria-hidden="true">
            <span class="sigil-circle"></span>
            <span class="sigil-diamond"></span>
            <span class="sigil-star">✦</span>
          </div>
          <p class="section-kicker">The shelves are being arranged</p>
          <h2 id="empty-title">The collection is taking shape.</h2>
          <p>Nothing has been published here yet. The welcome can stand on its own while the first pieces are prepared with care.</p>
          <span class="quiet-mark" aria-hidden="true">✦</span>
        </section>
      )}

      {reviewExamplesEnabled && (
        <div class="portrait-slot">
          <PortraitPlaceholder />
        </div>
      )}
    </div>

    {supportingEntries.length > 0 && (
      <section class="supporting section-shell" aria-labelledby="supporting-title">
        <div class="collection-thread" aria-hidden="true"><span></span><span></span><span></span></div>
        <h2 class="visually-hidden" id="supporting-title">More from the collection</h2>
        <div class="supporting-grid">
          {supportingEntries.map((entry) => <CollectionCard {...entry} />)}
        </div>
      </section>
    )}
  </main>

  <footer class="site-footer">
    <p><span aria-hidden="true">✦</span> Not Entirely Unrelated is a provisional name for this review.</p>
    <p>Built from the open-source <a href="https://github.com/kpab/astro-darkness">Darkness Astro theme</a> by kpab.</p>
  </footer>
</BaseLayout>

<style>
  .collection-home { color: var(--color-text); }
  .section-shell, .site-footer { width: min(100% - 2rem, 1120px); margin-inline: auto; }

  .opening {
    --opening-gap: clamp(3.5rem, 8vw, 7rem);
    padding: clamp(8.5rem, 14vh, 10rem) 0 clamp(4.5rem, 7vw, 6rem);
    display: grid;
    grid-template-columns: minmax(280px, 0.72fr) minmax(0, 1.28fr);
    grid-template-areas:
      'welcome feature'
      'portrait feature';
    align-items: start;
    column-gap: var(--opening-gap);
    row-gap: 2rem;
    position: relative;
  }

  .welcome-slot { grid-area: welcome; min-width: 0; padding-top: 2rem; }
  .featured-cluster, .quiet-empty { grid-area: feature; min-width: 0; }
  .portrait-slot { grid-area: portrait; align-self: end; }

  .section-kicker {
    margin: 0 0 0.75rem;
    color: #bd9966;
    font-size: 0.66rem;
    font-weight: 650;
    letter-spacing: 0.17em;
    text-transform: uppercase;
  }

  h2 {
    margin: 0;
    color: var(--color-text);
    font-family: 'Newsreader', Georgia, serif;
    font-size: clamp(2.5rem, 5vw, 4.35rem);
    font-weight: 300;
    letter-spacing: -0.04em;
    line-height: 0.98;
    text-wrap: balance;
  }

  .featured-heading {
    margin-bottom: 1.3rem;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(160px, 0.45fr);
    align-items: end;
    gap: 1.5rem;
  }

  .featured-heading h2 {
    font-size: clamp(1.75rem, 2.8vw, 2.35rem);
    letter-spacing: -0.025em;
    line-height: 1.05;
  }

  .review-note {
    max-width: 31ch;
    margin: 0 0 0.1rem auto;
    color: #a99d8d;
    font-size: 0.72rem;
    line-height: 1.65;
  }

  .review-note strong { color: #d1b382; font-weight: 600; }

  .supporting {
    padding: clamp(3.5rem, 6vw, 5rem) 0 clamp(5rem, 9vw, 8rem);
    position: relative;
    border-top: 1px solid rgba(205, 170, 112, 0.15);
  }

  .supporting-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }

  .collection-thread { width: min(28vw, 280px); height: 1px; position: absolute; top: -1px; right: 0; background: linear-gradient(90deg, transparent, rgba(205, 170, 112, 0.32)); }
  .collection-thread::before { content: ''; width: 42%; height: 1px; position: absolute; right: 5%; top: -18px; background: rgba(205, 170, 112, 0.12); transform: rotate(-9deg); transform-origin: right; }
  .collection-thread span { width: 4px; height: 4px; position: absolute; top: -2px; border: 1px solid rgba(213, 177, 119, 0.7); border-radius: 50%; background: #17130f; box-shadow: 0 0 9px rgba(213, 177, 119, 0.28); }
  .collection-thread span:nth-child(1) { left: 28%; }
  .collection-thread span:nth-child(2) { left: 61%; }
  .collection-thread span:nth-child(3) { right: 0; }

  .quiet-empty {
    min-height: 470px;
    padding: clamp(2.3rem, 4vw, 3.8rem);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    position: relative;
    overflow: hidden;
    border: 1px solid rgba(205, 170, 112, 0.15);
    background: linear-gradient(145deg, rgba(36, 27, 21, 0.5), rgba(24, 19, 15, 0.4));
  }

  .quiet-empty h2 { max-width: 11ch; font-size: clamp(2.5rem, 5vw, 4.1rem); }
  .quiet-empty > p:not(.section-kicker) { max-width: 50ch; margin: 1.2rem 0 0; color: var(--color-text-dim); font-size: 0.92rem; line-height: 1.72; }
  .quiet-mark { position: absolute; right: 1.5rem; bottom: 1.5rem; color: rgba(205, 170, 112, 0.32); font-size: 0.7rem; }

  .empty-sigil { width: clamp(165px, 20vw, 230px); aspect-ratio: 1; position: absolute; right: -2.5rem; top: 2rem; color: rgba(205, 170, 112, 0.14); }
  .sigil-circle, .sigil-diamond { position: absolute; inset: 12%; border: 1px solid currentColor; }
  .sigil-circle { border-radius: 50%; }
  .sigil-diamond { inset: 25%; transform: rotate(45deg); }
  .sigil-circle::before, .sigil-circle::after { content: ''; position: absolute; background: currentColor; }
  .sigil-circle::before { width: 140%; height: 1px; left: -20%; top: 50%; transform: rotate(-18deg); }
  .sigil-circle::after { width: 1px; height: 140%; left: 50%; top: -20%; }
  .sigil-star { position: absolute; inset: 0; display: grid; place-items: center; color: rgba(218, 180, 119, 0.55); font-size: 0.65rem; text-shadow: 0 0 12px rgba(218, 180, 119, 0.45); }

  .visually-hidden { width: 1px; height: 1px; padding: 0; position: absolute; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }

  .site-footer { padding: 2rem 0 2.6rem; display: flex; justify-content: space-between; gap: 2rem; border-top: 1px solid rgba(205, 170, 112, 0.15); color: #a99f91; font-size: 0.72rem; line-height: 1.65; }
  .site-footer p { max-width: 54ch; margin: 0; }
  .site-footer p:first-child span { margin-right: 0.4rem; color: #bd9966; }
  .site-footer a { color: #ccb184; text-underline-offset: 0.2rem; }

  @media (max-width: 860px) {
    .opening { --opening-gap: 2.75rem; }
    .featured-heading { grid-template-columns: 1fr; }
    .review-note { margin-left: 0; }
  }

  @media (max-width: 720px) {
    .section-shell, .site-footer { width: min(100% - 1.5rem, 1120px); }

    .opening {
      padding-top: 7.6rem;
      padding-bottom: 4.5rem;
      grid-template-columns: 1fr;
      grid-template-areas:
        'welcome'
        'feature'
        'portrait';
      row-gap: 2.25rem;
    }

    .welcome-slot { padding-top: 0; }
    .featured-heading { margin-bottom: 1.2rem; }
    .featured-heading h2 { font-size: clamp(1.85rem, 8vw, 2.2rem); }
    .portrait-slot { padding-top: 0.5rem; }

    .quiet-empty { min-height: 360px; padding: 2rem 1.35rem; }
    .quiet-empty h2 { font-size: clamp(2.45rem, 11vw, 3.25rem); }
    .empty-sigil { width: 155px; right: -4rem; top: 1.2rem; opacity: 0.78; }

    .supporting { padding-top: 3.5rem; padding-bottom: 5rem; }
    .supporting-grid { grid-template-columns: 1fr; }
    .collection-thread { width: 42vw; }
    .site-footer { flex-direction: column; gap: 0.7rem; }
  }
</style>
