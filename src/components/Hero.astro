---
---

<section class="hero" aria-labelledby="hero-title">
  <div class="ambient-mark mark-one" aria-hidden="true">✦</div>
  <div class="ambient-mark mark-two" aria-hidden="true">◌</div>
  <div class="ambient-orbit" aria-hidden="true"></div>

  <div class="hero-content">
    <p class="eyebrow">Homepage preview <span aria-hidden="true">·</span> provisional copy</p>
    <h1 id="hero-title">
      Good questions have a way of <em>wandering.</em>
    </h1>
    <p class="hero-description">
      This introduction is here to test tone, scale, and rhythm. Final language will be written and approved separately.
    </p>
    <a class="hero-cta" href="#selected">
      <span>Explore the page preview</span>
      <svg aria-hidden="true" width="15" height="15" viewBox="0 0 16 16" fill="none">
        <path d="M4 4h8v8M12 4 4.5 11.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </a>
    <p class="marginalia" aria-label="Provisional marginal note">the words are still finding their shape</p>
  </div>
</section>

<style>
  .hero {
    width: min(100% - 2rem, 1180px);
    min-height: min(760px, 88svh);
    margin: 0 auto;
    padding: clamp(8rem, 18vh, 10rem) 0 clamp(4.25rem, 9vh, 6.5rem);
    display: grid;
    align-items: center;
    position: relative;
    isolation: isolate;
  }

  .hero-content {
    width: min(100%, 780px);
    position: relative;
    z-index: 1;
  }

  .eyebrow {
    margin: 0 0 1.35rem;
    color: #d0ae78;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    line-height: 1.5;
    text-transform: uppercase;
  }

  h1 {
    max-width: 740px;
    margin: 0;
    color: var(--color-text);
    font-family: 'Newsreader', Georgia, serif;
    font-size: clamp(3.35rem, 10vw, 7.15rem);
    font-weight: 300;
    letter-spacing: -0.047em;
    line-height: 0.91;
    text-wrap: balance;
  }

  h1 em {
    color: #d3b17c;
    font-family: 'Fraunces', Georgia, serif;
    font-weight: 400;
  }

  .hero-description {
    max-width: 590px;
    margin: 1.75rem 0 0;
    color: var(--color-text-dim);
    font-size: clamp(0.96rem, 1.5vw, 1.08rem);
    line-height: 1.75;
  }

  .hero-cta {
    width: fit-content;
    min-height: 48px;
    margin-top: 2rem;
    padding: 0.76rem 1.05rem 0.76rem 1.15rem;
    display: inline-flex;
    align-items: center;
    gap: 0.85rem;
    border: 1px solid rgba(205, 170, 112, 0.48);
    border-radius: 999px;
    color: var(--color-text);
    font-size: 0.87rem;
    font-weight: 600;
    text-decoration: none;
    transition: background 180ms ease, border-color 180ms ease, transform 180ms ease;
  }

  .hero-cta:hover,
  .hero-cta:focus-visible {
    background: rgba(205, 170, 112, 0.09);
    border-color: #d0aa70;
    transform: translateY(-2px);
  }

  .marginalia {
    width: fit-content;
    margin: 1.4rem 0 0 clamp(1.5rem, 7vw, 5.2rem);
    color: #aa9477;
    font-family: 'Caveat', 'Bradley Hand', cursive;
    font-size: clamp(1.02rem, 2.3vw, 1.24rem);
    line-height: 1.25;
    transform: rotate(-1.5deg);
  }

  .marginalia::before {
    content: '↳';
    margin-right: 0.45rem;
    color: #8f7656;
  }

  .ambient-mark,
  .ambient-orbit {
    position: absolute;
    z-index: -1;
    color: rgba(205, 170, 112, 0.24);
    pointer-events: none;
    user-select: none;
  }

  .ambient-mark {
    animation: drift 14s ease-in-out infinite;
  }

  .mark-one {
    top: 24%;
    right: 7%;
    font-size: 0.9rem;
  }

  .mark-two {
    right: 21%;
    bottom: 20%;
    color: rgba(205, 170, 112, 0.13);
    font-size: 2rem;
    animation-delay: -5s;
  }

  .ambient-orbit {
    width: 180px;
    height: 180px;
    right: -30px;
    bottom: 11%;
    border: 1px solid rgba(205, 170, 112, 0.07);
    border-radius: 50%;
  }

  .ambient-orbit::after {
    content: '';
    width: 5px;
    height: 5px;
    position: absolute;
    top: 35px;
    left: 19px;
    border: 1px solid rgba(205, 170, 112, 0.35);
    border-radius: 50%;
  }

  @keyframes drift {
    0%, 100% { transform: translate3d(0, 0, 0) rotate(0); }
    50% { transform: translate3d(6px, -9px, 0) rotate(8deg); }
  }

  @media (max-width: 720px) {
    .hero {
      min-height: auto;
      padding-top: 7.25rem;
      padding-bottom: 4.5rem;
    }

    h1 {
      max-width: 600px;
      font-size: clamp(3.25rem, 16vw, 5.1rem);
      line-height: 0.94;
    }

    .hero-description {
      max-width: 35rem;
      margin-top: 1.5rem;
      font-size: 0.98rem;
      line-height: 1.7;
    }

    .hero-cta {
      margin-top: 1.75rem;
    }

    .marginalia {
      margin-top: 1.5rem;
      margin-left: 1rem;
    }

    .mark-one {
      top: 18%;
      right: 4%;
    }

    .mark-two,
    .ambient-orbit {
      display: none;
    }
  }

  @media (max-width: 380px) {
    .hero {
      width: min(100% - 1.5rem, 1180px);
      padding-top: 6.8rem;
      padding-bottom: 4rem;
    }

    .eyebrow {
      margin-bottom: 1.1rem;
      font-size: 0.65rem;
    }

    h1 {
      font-size: clamp(3.05rem, 16vw, 3.6rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ambient-mark {
      animation: none;
    }

    .hero-cta:hover,
    .hero-cta:focus-visible {
      transform: none;
    }
  }
</style>
